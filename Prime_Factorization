
#include <bits/stdc++.h>

using namespace std;

int main() {
    long long n;
    cin >> n;
    long long i = 2;
    while (i * i <= n) {
            if (n % i == 0) {
                cout << i << " ";
                n /= i;
            } else {
                i++;
            }
    }
    if(n > 1){
        cout << n;
    }    
        

    
    return 0;
}
